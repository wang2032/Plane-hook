PORT=3000
NODE_ENV=production

# 企业微信群机器人 Webhook URL（默认）
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY_HERE

# 业务部企业微信群机器人 Webhook URL
WECOM_WEBHOOK_URL_BUS=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_BUS_KEY_HERE

# 项目ID到企业微信群的映射（JSON格式）
# 格式: {"项目ID": "webhook_url", "项目ID2": "webhook_url2"}
PROJECT_WEBHOOK_MAPPING={"project-id-1":"webhook_url_1","project-id-2":"webhook_url_2"}